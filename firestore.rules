rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection — Strict isolation
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) 
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name', 'image', 'bio', 'updatedAt']);
      allow create: if false; // Users should only be created via the Admin API
      allow delete: if false;
    }

    // AI Usage — Restricted to server-side only
    match /ai_usage/{docId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false; // Server-side admin SDK only
    }

    // Shortened URLs — Redirection is public, creation is restricted to protect against spam
    match /short_urls/{code} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // Feedback & Contact - server-side Admin API only
    match /feedback/{docId} {
      allow read, write: if false;
    }

    match /contact_messages/{docId} {
      allow read, write: if false;
    }

    // Newsletter subscribers - server-side Admin API only
    match /newsletter_subscribers/{docId} {
      allow read, write: if false;
    }
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
